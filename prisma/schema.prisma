generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User{
  id Int @id @default(autoincrement())
  name String
  mail String @unique
  passwordHash String
  bio String @default("")

  session Session[]
  post Post[]
}

model Session{
  id String @id
  userId Int 
  
  user User @relation(fields:[userId],references:[id])
}

model Post{
  id Int @id @default(autoincrement())
  content String
  userId Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}